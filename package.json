{
  "name": "rr-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "rr": "./dist/index.js"
  },
  "files": [
    "dist",
    "template",
    "extras"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup src/index.ts --format esm --clean --sourcemap && cp src/installers/optional-deps.json dist/",
    "fix": "biome check --write --unsafe",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lab:clean": "tsx scripts/clean-lab.ts",
    "lab:scaffold": "tsx scripts/scaffold-lab.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "commander": "^15.0.0",
    "fs-extra": "^11.4.0",
    "picocolors": "^1.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.1.2",
    "tsup": "^8.5.1",
    "tsx": "~4.22.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18"
  }
}
