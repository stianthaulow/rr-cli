{
  "name": "rr-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "rr": "./dist/index.js"
  },
  "files": [
    "dist",
    "template",
    "extras"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup src/index.ts --format esm --clean --sourcemap && cp src/installers/optional-deps.json dist/",
    "fix": "biome check --write --unsafe",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lab:clean": "tsx scripts/clean-lab.ts",
    "lab:scaffold": "tsx scripts/scaffold-lab.ts"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "commander": "^14.0.0",
    "fs-extra": "^11.3.0",
    "picocolors": "^1.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.0.9",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^6.0.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18"
  }
}
