{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^src/installers/optional-deps\\.json$"],
      "matchStrings": [
        "\"(?<depName>@?[a-z0-9-]+(/[a-z0-9-]+)?)\":\\s*\"\\^?(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""
      ],
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    }
  ]
}
